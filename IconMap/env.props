<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Set this to your SFS Mods folder (optional; only used if AutoCopyToMods=true) -->
    <ModsFolder>C:\Program Files (x86)\Steam\steamapps\common\Spaceflight Simulator\Spaceflight Simulator Game\Mods</ModsFolder>
    <DllName>bin\Release\IconMap.dll</DllName>
    <!-- false = build only, no copy into game (avoids MSB3021 when the game is running) -->
    <AutoCopyToMods>false</AutoCopyToMods>
  </PropertyGroup>
</Project>
